{
	"name": "figen-user-portal",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:next": "next lint",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,scss,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.2.0",
		"clsx": "^2.1.0",
		"next": "^16.1.6",
		"next-intl": "^4.7.0",
		"react": "^18.3.0",
		"react-dom": "^18.3.0",
		"react-redux": "^9.1.0",
		"tailwind-merge": "^2.2.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@next/eslint-plugin-next": "^16.1.4",
		"@types/node": "^20.12.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^8.53.1",
		"@typescript-eslint/parser": "^8.53.1",
		"autoprefixer": "^10.4.0",
		"eslint": "^9.39.2",
		"eslint-config-next": "^16.1.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"postcss": "^8.4.0",
		"prettier": "^3.8.0",
		"tailwindcss": "^3.4.0",
		"typescript": "^5.4.0"
	}
}
